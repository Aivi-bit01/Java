                                                //i=2  nums[i]=0 || nums[i]!=0 -> nums[2]!=0 ->false   [1 , 0 , 0 , 3 , 12 ]
}                                               //i=3  nums[i]=3 || nums[i]!=0 -> nums[3]!=0 -> true
