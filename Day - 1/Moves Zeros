class Solution {
    public void moveZeroes(int[] nums) {
        int j=0;
        for(int i=0;i<nums.length;i++){
            if(nums[i]!=0){
                int temp=nums[i];
                nums[i]=nums[j];
                nums[j]=temp;
                j++;                             //nums=[0 , 1 , 0 , 3 , 12 ]
            }                                    //i=0 nums[i]=0 || nums[i]!=0 -> nums[0]!=0 -> false j=0   //nums=[0 , 1 , 0 , 3 , 12 ]
        }                                        //i=1 nums[i]=0 || nums[i]!=0 -> nums[1]!=0 -> true
    }                                                                      //temp=nums[i]=1
                                                                            //nums[1]=nums[0]
                                                                            //nums[0]=temp  [1 , 0 , 0 , 3 , 12 ]
